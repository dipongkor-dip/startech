# PostgreSQL
POSTGRES_USER=startech
POSTGRES_PASSWORD=startech
POSTGRES_DB=startech
# MongoDB
MONGO_INITDB_ROOT_USERNAME=startech
MONGO_INITDB_ROOT_PASSWORD=startech
# Database URLs
POST_DATABASE_URL=postgresql://startech:startech@postgres:5432/startech
MONGO_DATABASE_URL=mongodb://startech:startech@mongodb:27017/startech?authSource=admin
RABBITMQ_URL=amqp://rabbitmq:5672



# -----------------------------------------------
# Service URLs (for inter-service communication)
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
DELIVERY_SERVICE_URL=http://delivery:5001
ORDER_SERVICE_URL=http://order:5002
USER_SERVICE_URL=http://user:5003
PRODUCT_SERVICE_URL=http://product:5004
PAYMENT_SERVICE_URL=http://payment:5005
CHAT_SERVICE_URL=http://payment:5006



#------------------------------------------------------------------
# Frontend -----------------------------------------------
# API_URL: used by frontend server to reach user service (Docker: http://user:5003)
API_URL=http://user:5003
NEXT_PUBLIC_API_URL=http://localhost:5003
NEXT_PUBLIC_PRODUCT_API=http://localhost:5004
# User service OAuth callback URL (must be reachable from browser)
USER_PUBLIC_URL=http://localhost:5003


#------------------------------------------------------------------
# Backend - Delivery -----------------------------------------------
DELIVERY_PORT=5001


#------------------------------------------------------------------
# Backend - Order -----------------------------------------------
ORDER_PORT=5002


#------------------------------------------------------------------
# Backend - User -----------------------------------------------
USER_PORT=5003
# Google OAuth - get from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook OAuth - get from https://developers.facebook.com/
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

SMS_GATEWAY_DOMAIN=

JWT_SECRET=startech-jwt-secret-change-in-production
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=3d

SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@startech.com

REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://rabbitmq:5672

SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWOR=



# ------------------------------------------------------------------
# Backend - Product -----------------------------------------------
PRODUCT_PORT=5004


#------------------------------------------------------------------
# Backend - Payment -----------------------------------------------
PAYMENT_PORT=5005



#------------------------------------------------------------------
# Backend - Chat -----------------------------------------------
CHAT_PORT=5006


