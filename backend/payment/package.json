{
  "name": "payment-service",
  "version": "1.0.0",
  "description": "Payment microservice",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "prisma generate --schema=./prisma/schema.prisma && tsc",
    "start": "node dist/server.js",
    "dev": "prisma generate --schema=./prisma/schema.prisma && nodemon",
    "db:push": "prisma db push --schema=./prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema=./prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "prisma": "^5.22.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.0",
    "tsx": "^4.19.0",
    "nodemon": "^3.1.14"
  },
  "packageManager": "pnpm@9.0.0"
}
